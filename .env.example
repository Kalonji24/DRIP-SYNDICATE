# ─────────────────────────────────────────────────────────────────────────────
# DRIP Syndicate — environment template. Copy to .env and fill in real values.
# The backend maps double-underscores to nested config keys (Jwt__Secret → Jwt:Secret).
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (ASP.NET Core) ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# PostgreSQL / Supabase connection (Npgsql format)
ConnectionStrings__Default=Host=db;Port=5432;Database=dripsyndicate;Username=postgres;Password=postgres

# JWT — Secret MUST be at least 32 characters and kept private
Jwt__Issuer=drip-syndicate
Jwt__Audience=drip-syndicate-client
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# Supabase Storage (media uploads)
Supabase__Url=https://YOUR-PROJECT.supabase.co
Supabase__ServiceKey=YOUR_SUPABASE_SERVICE_ROLE_KEY
Supabase__Bucket=media

# Allowed CORS origins (storefront URLs); add more as __1, __2, …
Cors__Origins__0=http://localhost:3000

# Seed roles + admin + demo catalogue on first boot. Set false afterwards.
Seed__Enabled=true

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Inlined into the client bundle at BUILD time. Must point at the API base + /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
